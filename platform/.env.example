# Copy to .env and change every value. NEVER commit .env (it is git-ignored).
GRL_ENV=development
GRL_DB_PASSWORD=change-me-strong-db-password
# 32+ random characters. Signs download links and derives the storage encryption key. Required in staging/production.
GRL_SECRET_KEY=change-me-to-a-long-random-secret-of-at-least-32-chars
# Kept separately from the database credentials; needed to restore backups.
GRL_BACKUP_KEY=change-me-separate-backup-key
GRL_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Development only: show mock OTPs on screen. MUST be false in staging/production.
GRL_EXPOSE_DEV_OTP=true
GRL_ADMIN_PASSWORD=
# Optional live AI providers (leave blank = MOCK assistant)
GRL_ANTHROPIC_API_KEY=
GRL_OPENAI_API_KEY=
# Dedicated GPS tracker webhook shared key
GRL_TRACKER_KEY=change-me-tracker-key
