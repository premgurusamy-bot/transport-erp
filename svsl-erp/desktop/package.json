{
  "name": "svsl-erp-desktop",
  "productName": "SVL ERP",
  "version": "1.0.0",
  "description": "Sree Venkateswara Logistics ERP – Windows desktop app",
  "main": "main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "author": "Sree Venkateswara Logistics",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "in.svsl.erp",
    "productName": "SVL ERP",
    "copyright": "Sree Venkateswara Logistics",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "setup.html", "starting.html", "icon.png", "package.json"],
    "extraResources": [
      { "from": "res/server", "to": "server" },
      { "from": "res/pgsql", "to": "pgsql" },
      { "from": "res/web", "to": "web" }
    ],
    "win": { "target": "nsis", "icon": "icon.png", "artifactName": "SVL-ERP-Setup-${version}.exe" },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SVL ERP",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
