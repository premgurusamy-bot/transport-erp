# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://svsl:CHANGE_ME@localhost:5432/svsl_erp
# Long random string (python -c "import secrets;print(secrets.token_urlsafe(64))")
SECRET_KEY=
# Fernet key for Aadhaar / bank numbers (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# Keep a safe copy: encrypted fields cannot be read without it.
DATA_ENCRYPTION_KEY=
# Public URL printed in LR / invoice QR codes
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
APP_ENV=production

# --- Storage ----------------------------------------------------------------
# STORAGE_DIR=/var/lib/svsl-erp
# BACKUP_DIR=/var/backups/svsl-erp
MAX_UPLOAD_MB=15
PG_DUMP_PATH=pg_dump
RUN_SCHEDULER=true
# INITIAL_ADMIN_PASSWORD=   (otherwise a random one is printed by `python -m app.seed`)

# --- Optional integrations (features show "not configured" until set) -------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=
IRP_BASE_URL=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=
EWB_BASE_URL=
EWB_CLIENT_ID=
EWB_CLIENT_SECRET=
EWB_USERNAME=
EWB_PASSWORD=
